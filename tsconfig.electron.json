{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "outDir": "dist-electron",
        "strict": true,
        "lib": [
            "ESNext"
        ],
        "skipLibCheck": true
    },
    "include": [
        "electron"
    ]
}