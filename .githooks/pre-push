#!/bin/sh
set -eu

needs_signing_check=0

while read local_ref local_sha remote_ref remote_sha
do
  case "$local_ref" in
    refs/tags/v*|refs/heads/prd)
      needs_signing_check=1
      ;;
  esac
done

if [ "$needs_signing_check" -eq 0 ]; then
  exit 0
fi

echo "[pre-push] Release/tag push detected (prd or v*). Verifying signed artifact..."

if npm run -s signing:verify-artifact >/dev/null 2>&1; then
  echo "[pre-push] Signed artifact verification passed."
  exit 0
fi

echo "[pre-push] Blocked: signed artifact verification failed."
echo "[pre-push] Run: npm run release:portable:signed"
echo "[pre-push] If this is local-only/non-release, push a non-release branch or use unsigned scripts intentionally."
exit 1
